{
  "name": "springlens",
  "version": "0.1.0",
  "description": "AI-powered onboarding and dependency-risk analysis for legacy Java/Spring Boot codebases.",
  "keywords": [
    "spring",
    "spring-boot",
    "java",
    "onboarding",
    "architecture",
    "dependency-risk",
    "static-analysis",
    "cli"
  ],
  "homepage": "https://github.com/rushiplays587-ops/springlens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rushiplays587-ops/springlens.git"
  },
  "bugs": {
    "url": "https://github.com/rushiplays587-ops/springlens/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "springlens": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "tsc && node --test dist/build.test.js dist/parser.test.js dist/narrate.test.js dist/depscan.test.js dist/scanner.test.js dist/ask.test.js dist/ask-ai.test.js dist/cli.test.js dist/redact.test.js dist/config.test.js dist/report.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
